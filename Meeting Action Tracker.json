        "jsCode": "let html = `\n<h2>Meeting Action Items</h2>\n<table border=\"1\" cellpadding=\"5\" cellspacing=\"0\">\n<tr>\n<th>Task</th>\n<th>Owner</th>\n<th>Due Date</th>\n<th>Status</th>\n</tr>\n`;\n\nfor (const item of $input.all()) {\n  html += `\n  <tr>\n    <td>${item.json.Task}</td>\n    <td>${item.json.Owner}</td>\n    <td>${item.json.DueDate}</td>\n    <td>${item.json.Status}</td>\n  </tr>\n  `;\n}\n\nhtml += `</table>`;\n\nreturn [{\n  json: {\n    emailBody: html\n  }\n}];"
      },
